{
  "name": "edgeguard-desktop",
  "version": "1.0.0",
  "description": "EdgeGuard Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "minimatch": "^11.0.3"
  },
  "build": {
    "appId": "com.edgeguard.desktop",
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*",
      "backend/**/*",
      "ml-sidecar/**/*",
      "data/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
